{
  "name": "@idexal/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "test:pr": "vitest run --config vitest.config.ts --project pr",
    "test:pr:coverage": "vitest run --config vitest.config.ts --project pr --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportsDirectory=./coverage",
    "test:e2e": "vitest run --config vitest.config.ts --project e2e",
    "artifacts:index": "node packages/test-artifacts/bin/artifact-index.mjs",
    "artifacts:publish": "node packages/test-artifacts/bin/publish-pr.mjs",
    "dev:den": "node scripts/dev-den.ts",
    "docs:shots": "node docs-shots/run.ts",
    "evidence:judge": "node packages/test-evidence/bin/test-evidence-judge.mjs",
    "design:review": "node packages/test-evidence/bin/test-evidence-design-review.mjs",
    "provision:org-connector-two-members": "node scripts/provision-org-connector-two-members.ts",
    "lint:layers": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages core proofs worlds bin docs-shots runner scripts ../scenarios",
    "check": "pnpm run check:browser && pnpm run lint:layers && pnpm run lint:specs",
    "lint:specs": "node scripts/spec-lint/cli.ts",
    "test:framework": "vitest run --config vitest.config.ts --project pr scripts",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:spec-layer": "tsc -p tsconfig.primitives.json",
    "check:browser": "node scripts/check-browser-code.mjs"
  },
  "dependencies": {
    "@idexal/behaviors": "workspace:*",
    "@idexal/cdp": "workspace:*",
    "@idexal/env": "workspace:*",
    "@idexal/hosts": "workspace:*",
    "@idexal/labs": "workspace:*",
    "@idexal/matchers": "workspace:*",
    "@idexal/review": "link:../packages/review",
    "@idexal/sdk": "link:../packages/sdk",
    "@idexal/design-review": "workspace:*",
    "@idexal/test-artifacts": "workspace:*",
    "@idexal/test-evidence": "workspace:*",
    "@idexal/testkit": "workspace:*",
    "@idexal/types": "link:../packages/types",
    "@idexal/world": "link:../packages/world"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "18.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "xml-crypto": "6.1.2",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.4.0"
}
