=======================================
idexal Os Production Server - .env File
=======================================

COPY THIS FILE TO: /var/www/vhosts/idexal.com/os.idexal.com-app/.env
DO NOT MODIFY UNLESS YOU KNOW WHAT YOU'RE DOING!

APP_NAME="idexal Os"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://os.idexal.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idexal_os
DB_USERNAME=idexal
# SET DB_PASSWORD in Plesk Panel BEFORE deployment

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=os.idexal.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="os@idexal.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

IDEXAL_DESKTOP_SCHEME=idexalos
IDEXAL_HANDOFF_TTL=10
IDEXAL_DESKTOP_TOKEN_DAYS=365
IDEXAL_SUPPORT_EMAIL=os@idexal.com
IDEXAL_INFO_EMAIL=info@idexal.com
IDEXAL_ALLOW_REGISTRATION=true
IDEXAL_REQUIRE_EMAIL_VERIFICATION=false
IDEXAL_CURRENCY=USD
IDEXAL_INVOICE_PREFIX=IXO
IDEXAL_TAX_RATE=0
IDEXAL_GRACE_DAYS=3
IDEXAL_TRIAL_DAYS=14
IDEXAL_GATEWAY_ENABLED=true
IDEXAL_GATEWAY_TIMEOUT=180
IDEXAL_GATEWAY_STREAM_TIMEOUT=600
IDEXAL_GATEWAY_LOG_RETENTION_DAYS=90
IDEXAL_GATEWAY_RATE_LIMIT=120
IDEXAL_GATEWAY_MAX_BODY_KB=1024

# Only the canonical host is official. Additional hosts answer the same machine
# API; browser surfaces are redirected to the canonical host.
IDEXAL_CANONICAL_HOST=os.idexal.com
IDEXAL_ADDITIONAL_HOSTS=api.idexal.com

# The bundled marketplace catalog is the source of truth. Set this to true only
# if you also want live rows pulled from the public catalog repository.
IDEXAL_MARKETPLACE_REMOTE=false
IDEXAL_MARKETPLACE_REPOSITORY=idexal/extensions-catalog

STRIPE_KEY=your_stripe_key_here
STRIPE_SECRET=your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@idexal.com

# Optional: required only when IDEXAL_MARKETPLACE_REMOTE=true.
GITHUB_TOKEN=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAXmind_LICENSE_KEY=

CLOUD_SIGN_IN_ENABLED=false
CLOUD_ENABLED=false

=======================================
CRITICAL NOTES:
=======================================
✅ APP_LOCALE=en is MANDATORY for Western numerals
✅ The platform is self-contained: no external service is required
✅ STRIPE keys need to be set by you (obtain from stripe.com)
✅ MAIL settings configure notifications (optional)
=======================================