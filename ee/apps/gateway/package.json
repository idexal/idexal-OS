{
  "name": "@idexal-ee/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "models:build": "node scripts/build-models.mjs",
    "dev": "pnpm run models:build && tsx watch src/server.ts",
    "dev:local": "IDEXAL_DEV_MODE=1 pnpm run models:build && IDEXAL_DEV_MODE=1 PORT=${GATEWAY_PORT-${INFERENCE_PORT:-8791}} tsx watch src/server.ts",
    "build": "pnpm run build:workspace-dependencies && pnpm run models:build && tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "test": "node --conditions=development --import tsx --test test/*.test.ts",
    "build:workspace-dependencies": "node ../../../scripts/build-workspace-dependencies.mjs @idexal-ee/gateway"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@idexal-ee/den-db": "workspace:*",
    "@idexal-ee/telemetry": "workspace:*",
    "@idexal-ee/utils": "workspace:*",
    "@idexal/free-auto": "workspace:*",
    "@idexal/types": "workspace:*",
    "@sentry/hono": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "dotenv": "^16.4.5",
    "hono": "4.13.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/mistral": "3.0.51",
    "@types/node": "^20.11.30",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
