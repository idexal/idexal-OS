{
  "name": "@idexal-ee/telemetry",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": {
        "idexal-os-build": "./dist/types/src/index.d.ts",
        "default": "./src/index.ts"
      },
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@idexal-ee/den-db": "workspace:*",
    "@idexal-ee/telemetry-contracts": "workspace:*",
    "@idexal-ee/utils": "workspace:*",
    "@idexal/features": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.5.0",
    "typescript": "^5.5.4"
  }
}
